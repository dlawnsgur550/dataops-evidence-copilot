{"data": {"conn_name": "list_dataops_c_cp2_analytics", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "67d62158-2999-4813-9fb4-410e6de11241", "level": "debug", "msg": "On list_dataops_c_cp2_analytics: /* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  ", "name": "SQLQuery", "pid": 344, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-10-20T08:11:48.198071Z"}}
