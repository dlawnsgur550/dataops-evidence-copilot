{"data": {"conn_name": "list_dataops_c_cp2_analytics", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2b4da55f-c2dc-4759-a514-b2972a6725c4", "level": "debug", "msg": "On list_dataops_c_cp2_analytics: /* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  ", "name": "SQLQuery", "pid": 278, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-10-22T00:29:01.424134Z"}}
