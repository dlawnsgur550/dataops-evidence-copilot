{"data": {"conn_name": "list_dataops_c_cp2_analytics", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "e9640f0d-35cf-4839-b5ca-a6dfd6595a6c", "level": "debug", "msg": "On list_dataops_c_cp2_analytics: /* {\"app\": \"dbt\", \"dbt_version\": \"1.9.10\", \"profile_name\": \"orders_demo\", \"target_name\": \"local\", \"connection_name\": \"list_dataops_c_cp2_analytics\"} */\nselect\n      'dataops_c_cp2' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'analytics'\n    union all\n    select\n      'dataops_c_cp2' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'analytics'\n  ", "name": "SQLQuery", "pid": 373, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-10-22T00:29:10.860669Z"}}
